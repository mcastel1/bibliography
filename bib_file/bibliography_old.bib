@article{collet1977epsilon,
  abstract      = {In this paper, the Hierarchical Model is studied near a non-trivial fixed point φɛ of its renormalization group. Our analysis is an extension of work of Bleher and Sinai. We prove the validity of the ɛ-expansion for φɛ. We then show that the renormalization transformations around φɛ have an unstable manifold which is completely characterized by the tangent map and can be brought to normal form. We then establish relations between this result and the critical behaviour of the model in the thermodynamic limit.},
  affiliation   = {D{\'e}partement de Physique Th{\'e}orique Universit{\'e} de Gen{\`e}ve CH-1211 Gen{\'e}ve 4 Switzerland},
